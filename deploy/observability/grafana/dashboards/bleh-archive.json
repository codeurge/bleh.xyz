      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le, route) (rate(bleh_history_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{route}}"
        }
