        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(bleh_archive_anchor_last_success_timestamp_seconds{anchor=\"ots\"}) * 1000",
          "legendFormat": ""
