          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (archive) (increase(bleh_archive_manifest_failures_total[1h]))",
          "legendFormat": "manifest {{archive}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (archive, anchor) (increase(bleh_archive_anchor_failures_total[1h]))",
          "legendFormat": "anchor {{anchor}} {{archive}}"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (job) (increase(bleh_signing_failures_total[1h]))",
          "legendFormat": "signing {{job}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "History API",
      "id": 10,
      "collapsed": false,
