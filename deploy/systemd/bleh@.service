# Container alternative to docker compose for one bleh service per unit:
#
#   systemctl enable --now bleh@origin    (node box: reader, signer, gateway, capture)
#   systemctl enable --now bleh@relay     (relay)
#
# bleh@archive-capture (standalone `archive capture run --follow`) is only
# for a node box whose origin does not capture.
#
# Each instance reads /etc/bleh/<instance>.env (examples in
# deploy/systemd/env/), which sets BLEH_IMAGE, BLEH_DOCKER_ARGS (mounts,
# secrets, published ports), optionally BLEH_ARGS (command-line arguments;
# origin and the relay take everything from variables) and the service's
# own variables. The env file is also passed to the container, so it must
# stay mode 600 when it holds credentials. Containers use host networking:
# listen on loopback, the overlay address, or all addresses only for ports
# the host firewall admits on the overlay alone (8080, the gateway).
[Unit]
Description=bleh %i
Documentation=file:///opt/bleh/src/deploy/README.md
After=docker.service wg-quick@bleh0.service
Requires=docker.service

[Service]
Type=simple
EnvironmentFile=/etc/bleh/%i.env
ExecStartPre=-/usr/bin/docker rm -f bleh-%i
ExecStart=/usr/bin/docker run --rm --name bleh-%i \
  --network host --read-only --tmpfs /tmp:size=256m \
  --cap-drop ALL --security-opt no-new-privileges:true \
  --log-driver journald --log-opt tag=bleh-%i \
  --env-file /etc/bleh/%i.env \
  $BLEH_DOCKER_ARGS $BLEH_IMAGE $BLEH_ARGS
ExecStop=/usr/bin/docker stop --time 30 bleh-%i
Restart=always
RestartSec=5
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
