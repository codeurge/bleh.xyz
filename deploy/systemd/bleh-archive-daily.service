[Unit]
Description=bleh: daily archive pipeline (replay, manifests, anchors, publish, verify)
Documentation=file:///opt/bleh/src/docs/operations/archive.md
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/bleh/archive.env
ExecStart=/opt/bleh/src/deploy/scripts/archive-pipeline.sh daily
TimeoutStartSec=6h
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
