{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bleh.xyz/specs/observation-v0.schema.json",
  "title": "Observation record, v0",
  "description": "One mesh record. See observation-v0.md. Implemented by crates/mesh-types.",
  "oneOf": [
    { "$ref": "#/$defs/trade" },
    { "$ref": "#/$defs/book_event" },
    { "$ref": "#/$defs/book_snapshot" },
    { "$ref": "#/$defs/bar" },
    { "$ref": "#/$defs/footprint" },
    { "$ref": "#/$defs/volume_profile" },
    { "$ref": "#/$defs/swap_print" },
    { "$ref": "#/$defs/activity_bar" },
    { "$ref": "#/$defs/delta_bar" },
    { "$ref": "#/$defs/profile_summary" },
    { "$ref": "#/$defs/order_activity" },
    { "$ref": "#/$defs/queue_positions" },
    { "$ref": "#/$defs/sweep" },
    { "$ref": "#/$defs/heatmap_tile" },
    { "$ref": "#/$defs/liquidity_grade" },
    { "$ref": "#/$defs/coverage" },
    { "$ref": "#/$defs/reference_value" },
    { "$ref": "#/$defs/synthetic_month" },
    { "$ref": "#/$defs/positioning" }
  ],
  "$defs": {
    "decimal": {
      "description": "Fixed-point decimal: scale = number of fractional digits.",
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]{1,18})?$"
    },
    "nonneg_decimal": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]{1,18})?$"
    },
    "ms": { "description": "Unix milliseconds, UTC.", "type": "integer" },
    "ns": {
      "description": "Unix nanoseconds, UTC, as a canonical integer string.",
      "type": "string",
      "pattern": "^(0|-?[1-9][0-9]{0,18})$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "u32": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "u64": { "type": "integer", "minimum": 0 },
    "venue_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$" },
    "instrument_id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9-]{0,31}:[a-z0-9][a-z0-9-]{0,15}:[A-Za-z0-9_.@#+-]+(:[A-Za-z0-9_.@#+-]+)*$"
    },
    "admission_id": { "type": "string", "pattern": "^ADM-[0-9]{4,9}$" },
    "method_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,47}@[1-9][0-9]{0,5}$"
    },
    "flags": {
      "description": "Flag names in bit order, no duplicates.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "oracle_anchored_venue",
          "backfill",
          "gap_before",
          "low_resolution",
          "size_capped",
          "block_trade_delayed",
          "replayed",
          "exchange_referenced"
        ]
      }
    },
    "seq": {
      "type": "object",
      "additionalProperties": false,
      "required": ["block_number", "event_index"],
      "properties": {
        "block_number": { "$ref": "#/$defs/u64" },
        "event_index": { "$ref": "#/$defs/u32" }
      }
    },
    "prov": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instrument",
        "venue",
        "ts_source_ms",
        "ts_ingest_ns",
        "seq",
        "admission",
        "flags"
      ],
      "properties": {
        "instrument": { "$ref": "#/$defs/instrument_id" },
        "venue": { "$ref": "#/$defs/venue_id" },
        "ts_source_ms": { "$ref": "#/$defs/ms" },
        "ts_ingest_ns": { "$ref": "#/$defs/ns" },
        "ts_publish_ns": { "$ref": "#/$defs/ns" },
        "seq": { "$ref": "#/$defs/seq" },
        "admission": { "$ref": "#/$defs/admission_id" },
        "flags": { "$ref": "#/$defs/flags" }
      }
    },
    "derived": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "inputs_hash", "input_count"],
      "properties": {
        "method": { "$ref": "#/$defs/method_id" },
        "inputs_hash": { "$ref": "#/$defs/sha256" },
        "input_count": { "$ref": "#/$defs/u64" }
      }
    },
    "interval": { "enum": ["1s", "1m", "5m", "15m", "1h", "1d"] },
    "trade": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "prov", "price", "size", "aggressor", "trade_id"],
      "properties": {
        "kind": { "const": "trade" },
        "prov": { "$ref": "#/$defs/prov" },
        "price": { "$ref": "#/$defs/decimal" },
        "size": { "$ref": "#/$defs/nonneg_decimal" },
        "aggressor": { "enum": ["buy", "sell", "unknown"] },
        "trade_id": { "$ref": "#/$defs/u64" }
      }
    },
    "book_action": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "size"],
          "properties": {
            "type": { "const": "add" },
            "size": { "$ref": "#/$defs/nonneg_decimal" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "new_size"],
          "properties": {
            "type": { "enum": ["modify", "fill"] },
            "orig_size": { "$ref": "#/$defs/nonneg_decimal" },
            "new_size": { "$ref": "#/$defs/nonneg_decimal" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": { "type": { "const": "cancel" } }
        }
      ]
    },
    "book_event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "prov", "order_id", "side", "price", "action"],
      "properties": {
        "kind": { "const": "book_event" },
        "prov": { "$ref": "#/$defs/prov" },
        "order_id": { "$ref": "#/$defs/u64" },
        "side": { "enum": ["bid", "ask"] },
        "price": { "$ref": "#/$defs/decimal" },
        "action": { "$ref": "#/$defs/book_action" }
      }
    },
    "resting_order": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order_id", "price", "size", "ts_order_ms"],
      "properties": {
        "order_id": { "$ref": "#/$defs/u64" },
        "price": { "$ref": "#/$defs/decimal" },
        "size": { "$ref": "#/$defs/nonneg_decimal" },
        "ts_order_ms": { "$ref": "#/$defs/ms" }
      }
    },
    "level": {
      "type": "object",
      "additionalProperties": false,
      "required": ["price", "size", "order_count"],
      "properties": {
        "price": { "$ref": "#/$defs/decimal" },
        "size": { "$ref": "#/$defs/nonneg_decimal" },
        "order_count": { "$ref": "#/$defs/u32" }
      }
    },
    "book_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "prov", "depth"],
      "properties": {
        "kind": { "const": "book_snapshot" },
        "prov": { "$ref": "#/$defs/prov" },
        "depth": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "bids", "asks"],
              "properties": {
                "type": { "const": "l4" },
                "bids": { "type": "array", "items": { "$ref": "#/$defs/resting_order" } },
                "asks": { "type": "array", "items": { "$ref": "#/$defs/resting_order" } }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "bids", "asks"],
              "properties": {
                "type": { "const": "l2" },
                "bids": { "type": "array", "items": { "$ref": "#/$defs/level" } },
                "asks": { "type": "array", "items": { "$ref": "#/$defs/level" } }
              }
            }
          ]
        }
      }
    },
    "bar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "prov",
        "derived",
        "interval",
        "start_ms",
        "open",
        "high",
        "low",
        "close",
        "volume",
        "buy_volume",
        "sell_volume",
        "trade_count"
      ],
      "properties": {
        "kind": { "const": "bar" },
        "prov": { "$ref": "#/$defs/prov" },
        "derived": { "$ref": "#/$defs/derived" },
        "interval": { "$ref": "#/$defs/interval" },
        "start_ms": { "$ref": "#/$defs/ms" },
        "open": { "$ref": "#/$defs/decimal" },
        "high": { "$ref": "#/$defs/decimal" },
        "low": { "$ref": "#/$defs/decimal" },
        "close": { "$ref": "#/$defs/decimal" },
        "volume": { "$ref": "#/$defs/nonneg_decimal" },
        "buy_volume": { "$ref": "#/$defs/nonneg_decimal" },
        "sell_volume": { "$ref": "#/$defs/nonneg_decimal" },
        "trade_count": { "type": "integer", "minimum": 1, "maximum": 4294967295 }
      }
    },
    "footprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "prov", "derived", "interval", "start_ms", "levels"],
      "properties": {
        "kind": { "const": "footprint" },
        "prov": { "$ref": "#/$defs/prov" },
        "derived": { "$ref": "#/$defs/derived" },
        "interval": { "$ref": "#/$defs/interval" },
        "start_ms": { "$ref": "#/$defs/ms" },
        "levels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["price", "bid_volume", "ask_volume", "trade_count"],
            "properties": {
              "price": { "$ref": "#/$defs/decimal" },
              "bid_volume": { "$ref": "#/$defs/nonneg_decimal" },
              "ask_volume": { "$ref": "#/$defs/nonneg_decimal" },
              "trade_count": { "$ref": "#/$defs/u32" }
            }
          }
        }
      }
    },
    "volume_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "prov", "derived", "start_ms", "end_ms", "bucket", "levels"],
      "properties": {
        "kind": { "const": "volume_profile" },
        "prov": { "$ref": "#/$defs/prov" },
        "derived": { "$ref": "#/$defs/derived" },
        "start_ms": { "$ref": "#/$defs/ms" },
        "end_ms": { "$ref": "#/$defs/ms" },
        "bucket": { "$ref": "#/$defs/decimal" },
        "levels": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["price", "volume", "buy_volume", "sell_volume"],
            "properties": {
              "price": { "$ref": "#/$defs/decimal" },
              "volume": { "$ref": "#/$defs/nonneg_decimal" },
              "buy_volume": { "$ref": "#/$defs/nonneg_decimal" },
              "sell_volume": { "$ref": "#/$defs/nonneg_decimal" }
            }
          }
        }
      }
    },
    "activity_bar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind", "prov", "derived", "spec", "session_start_ms", "first_seq", "first_ms",
        "open", "high", "low", "close", "volume", "buy_volume", "sell_volume",
        "trade_count", "complete"
      ],
      "properties": {
        "kind": { "const": "activity_bar" },
        "prov": { "$ref": "#/$defs/prov" },
        "derived": { "$ref": "#/$defs/derived" },
        "spec": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "trades"],
              "properties": { "type": { "const": "tick" }, "trades": { "$ref": "#/$defs/u32" } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "size"],
              "properties": {
                "type": { "const": "volume" },
                "size": { "$ref": "#/$defs/nonneg_decimal" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "width"],
              "properties": { "type": { "const": "range" }, "width": { "$ref": "#/$defs/decimal" } }
            }
          ]
        },
        "session_start_ms": { "$ref": "#/$defs/ms" },
        "first_seq": { "$ref": "#/$defs/seq" },
        "first_ms": { "$ref": "#/$defs/ms" },
        "open": { "$ref": "#/$defs/decimal" },
        "high": { "$ref": "#/$defs/decimal" },
        "low": { "$ref": "#/$defs/decimal" },
        "close": { "$ref": "#/$defs/decimal" },
        "volume": { "$ref": "#/$defs/nonneg_decimal" },
        "buy_volume": { "$ref": "#/$defs/nonneg_decimal" },
        "sell_volume": { "$ref": "#/$defs/nonneg_decimal" },
        "trade_count": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "complete": { "type": "boolean" }
      }
    },
    "delta_bar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind", "prov", "derived", "interval", "start_ms", "buy_volume", "sell_volume",
        "volume_delta", "anchor_start_ms", "cvd"
      ],
      "properties": {
        "kind": { "const": "delta_bar" },
        "prov": { "$ref": "#/$defs/prov" },
        "derived": { "$ref": "#/$defs/derived" },
        "interval": { "$ref": "#/$defs/interval" },
        "start_ms": { "$ref": "#/$defs/ms" },
        "buy_volume": { "$ref": "#/$defs/nonneg_decimal" },
        "sell_volume": { "$ref": "#/$defs/nonneg_decimal" },
        "volume_delta": { "$ref": "#/$defs/decimal" },
        "anchor_start_ms": { "$ref": "#/$defs/ms" },
        "cvd": { "$ref": "#/$defs/decimal" }
      }
    },
    "profile_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind", "prov", "derived", "start_ms", "end_ms", "bucket", "value_area_bps", "poc",
        "value_area_low", "value_area_high", "value_area_volume", "total_volume"
      ],
      "properties": {
        "kind": { "const": "profile_summary" },
        "prov": { "$ref": "#/$defs/prov" },
        "derived": { "$ref": "#/$defs/derived" },
        "start_ms": { "$ref": "#/$defs/ms" },
        "end_ms": { "$ref": "#/$defs/ms" },
        "bucket": { "$ref": "#/$defs/decimal" },
        "value_area_bps": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "poc": { "$ref": "#/$defs/decimal" },
        "value_area_low": { "$ref": "#/$defs/decimal" },
        "value_area_high": { "$ref": "#/$defs/decimal" },
        "value_area_volume": { "$ref": "#/$defs/nonneg_decimal" },
        "total_volume": { "$ref": "#/$defs/nonneg_decimal" }
      }
    },
    "opt_ms": { "oneOf": [{ "type": "integer" }, { "type": "null" }] },
    "opt_u64": { "oneOf": [{ "$ref": "#/$defs/u64" }, { "type": "null" }] },
    "order_activity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind", "prov", "derived", "interval", "start_ms", "adds", "modifies", "cancels",
        "partial_fills", "full_fills", "added_size", "cancelled_size", "filled_size",
        "cancel_to_add_bps", "cancel_replace_to_fill_bps", "lifetimes"
      ],
      "properties": {
        "kind": { "const": "order_activity" },
        "prov": { "$ref": "#/$defs/prov" },
        "derived": { "$ref": "#/$defs/derived" },
        "interval": { "$ref": "#/$defs/interval" },
        "start_ms": { "$ref": "#/$defs/ms" },
        "adds": { "$ref": "#/$defs/u64" },
        "modifies": { "$ref": "#/$defs/u64" },
        "cancels": { "$ref": "#/$defs/u64" },
        "partial_fills": { "$ref": "#/$defs/u64" },
        "full_fills": { "$ref": "#/$defs/u64" },
        "added_size": { "$ref": "#/$defs/nonneg_decimal" },
        "cancelled_size": { "$ref": "#/$defs/nonneg_decimal" },
        "filled_size": { "$ref": "#/$defs/nonneg_decimal" },
        "cancel_to_add_bps": { "$ref": "#/$defs/opt_u64" },
        "cancel_replace_to_fill_bps": { "$ref": "#/$defs/opt_u64" },
        "lifetimes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "removed", "filled", "cancelled", "fleeting_cancels", "min_ms", "p50_ms", "p90_ms",
            "max_ms"
          ],
          "properties": {
            "removed": { "$ref": "#/$defs/u64" },
            "filled": { "$ref": "#/$defs/u64" },
            "cancelled": { "$ref": "#/$defs/u64" },
            "fleeting_cancels": { "$ref": "#/$defs/u64" },
            "min_ms": { "$ref": "#/$defs/opt_ms" },
            "p50_ms": { "$ref": "#/$defs/opt_ms" },
            "p90_ms": { "$ref": "#/$defs/opt_ms" },
            "max_ms": { "$ref": "#/$defs/opt_ms" }
          }
        }
      }
    },
    "queue_level": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["price", "total_size", "order_count", "orders", "truncated"],
          "properties": {
            "price": { "$ref": "#/$defs/decimal" },
            "total_size": { "$ref": "#/$defs/nonneg_decimal" },
            "order_count": { "$ref": "#/$defs/u32" },
            "orders": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["order_id", "size", "size_ahead", "ts_order_ms"],
                "properties": {
                  "order_id": { "$ref": "#/$defs/u64" },
                  "size": { "$ref": "#/$defs/nonneg_decimal" },
                  "size_ahead": { "$ref": "#/$defs/nonneg_decimal" },
                  "ts_order_ms": { "$ref": "#/$defs/ms" }
                }
              }
            },
            "truncated": { "type": "boolean" }
          }
        }
      ]
    },
    "queue_positions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "prov", "derived", "bid", "ask"],
      "properties": {
        "kind": { "const": "queue_positions" },
        "prov": { "$ref": "#/$defs/prov" },
        "derived": { "$ref": "#/$defs/derived" },
        "bid": { "$ref": "#/$defs/queue_level" },
        "ask": { "$ref": "#/$defs/queue_level" }
      }
    },
    "sweep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind", "prov", "derived", "side", "first_seq", "first_price", "last_price", "levels",
        "size", "trade_count"
      ],
      "properties": {
        "kind": { "const": "sweep" },
        "prov": { "$ref": "#/$defs/prov" },
        "derived": { "$ref": "#/$defs/derived" },
        "side": { "enum": ["buy", "sell"] },
        "first_seq": { "$ref": "#/$defs/seq" },
        "first_price": { "$ref": "#/$defs/decimal" },
        "last_price": { "$ref": "#/$defs/decimal" },
        "levels": { "type": "integer", "minimum": 2, "maximum": 4294967295 },
        "size": { "$ref": "#/$defs/nonneg_decimal" },
        "trade_count": { "$ref": "#/$defs/u32" }
      }
    },
    "heatmap_tile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind", "prov", "derived", "time_start_ms", "time_step_ms", "cols", "price_start",
        "price_step", "rows", "cells"
      ],
      "properties": {
        "kind": { "const": "heatmap_tile" },
        "prov": { "$ref": "#/$defs/prov" },
        "derived": { "$ref": "#/$defs/derived" },
        "time_start_ms": { "$ref": "#/$defs/ms" },
        "time_step_ms": { "type": "integer", "minimum": 1 },
        "cols": { "$ref": "#/$defs/u32" },
        "price_start": { "$ref": "#/$defs/decimal" },
        "price_step": { "$ref": "#/$defs/decimal" },
        "rows": { "$ref": "#/$defs/u32" },
        "cells": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["col", "row", "bid_size", "ask_size"],
            "properties": {
              "col": { "$ref": "#/$defs/u32" },
              "row": { "$ref": "#/$defs/u32" },
              "bid_size": { "$ref": "#/$defs/nonneg_decimal" },
              "ask_size": { "$ref": "#/$defs/nonneg_decimal" }
            }
          }
        }
      }
    },
    "liquidity_grade": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind", "prov", "derived", "as_of_ms", "window_ms", "samples", "spread_bps",
        "depth_bps", "depth_bid", "depth_ask", "trades", "trades_per_minute", "grade", "label"
      ],
      "properties": {
        "kind": { "const": "liquidity_grade" },
        "prov": { "$ref": "#/$defs/prov" },
        "derived": { "$ref": "#/$defs/derived" },
        "as_of_ms": { "$ref": "#/$defs/ms" },
        "window_ms": { "type": "integer", "minimum": 1 },
        "samples": { "$ref": "#/$defs/u32" },
        "spread_bps": {
          "oneOf": [{ "$ref": "#/$defs/nonneg_decimal" }, { "type": "null" }]
        },
        "depth_bps": { "$ref": "#/$defs/u32" },
        "depth_bid": { "$ref": "#/$defs/nonneg_decimal" },
        "depth_ask": { "$ref": "#/$defs/nonneg_decimal" },
        "trades": { "$ref": "#/$defs/u64" },
        "trades_per_minute": { "$ref": "#/$defs/nonneg_decimal" },
        "grade": { "enum": ["A", "B", "C", "D"] },
        "label": { "enum": ["benchmark", "tape"] }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind", "prov", "interval", "start_ms", "first_block", "last_block", "blocks",
        "missing_blocks", "gap_blocks"
      ],
      "properties": {
        "kind": { "const": "coverage" },
        "prov": { "$ref": "#/$defs/prov" },
        "interval": { "$ref": "#/$defs/interval" },
        "start_ms": { "$ref": "#/$defs/ms" },
        "first_block": { "$ref": "#/$defs/u64" },
        "last_block": { "$ref": "#/$defs/u64" },
        "blocks": { "type": "integer", "minimum": 1 },
        "missing_blocks": { "$ref": "#/$defs/u64" },
        "gap_blocks": { "$ref": "#/$defs/u64" }
      }
    },
    "date": { "description": "Calendar date.", "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$" },
    "reference_value": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind", "prov", "measure", "value", "tenor", "maturity_date", "day_count", "compounding",
        "currency", "as_of_date", "revision"
      ],
      "properties": {
        "kind": { "const": "reference_value" },
        "prov": { "$ref": "#/$defs/prov" },
        "measure": {
          "enum": [
            "rate", "par_yield", "zero_yield", "price", "index_level", "stock", "flow",
            "capacity", "ratio"
          ]
        },
        "value": { "$ref": "#/$defs/decimal" },
        "tenor": {
          "oneOf": [
            { "type": "string", "pattern": "^(ON|TN|[1-9][0-9]{0,2}[DWMY])$" },
            { "type": "null" }
          ]
        },
        "maturity_date": { "oneOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] },
        "day_count": {
          "oneOf": [
            { "enum": ["act_360", "act_365_fixed", "act_act", "thirty_360"] },
            { "type": "null" }
          ]
        },
        "compounding": {
          "oneOf": [
            { "enum": ["simple", "discount", "annual", "semi_annual", "continuous"] },
            { "type": "null" }
          ]
        },
        "currency": { "oneOf": [{ "type": "string", "pattern": "^[A-Z]{3}$" }, { "type": "null" }] },
        "as_of_date": { "$ref": "#/$defs/date" },
        "revision": { "$ref": "#/$defs/u32" },
        "period_start_ms": { "$ref": "#/$defs/ms" },
        "period_end_ms": { "$ref": "#/$defs/ms" },
        "unit": {
          "description": "Unit of a quantity (ADR 0023); omitted on every other measure.",
          "enum": [
            "barrels", "thousand_barrels", "thousand_barrels_per_day", "million_cubic_feet",
            "billion_cubic_feet", "pounds", "metric_tons", "head", "usd", "million_usd",
            "billion_usd", "percent"
          ]
        }
      },
      "dependentRequired": {
        "period_start_ms": ["period_end_ms"],
        "period_end_ms": ["period_start_ms"]
      },
      "allOf": [
        {
          "if": { "properties": { "measure": { "enum": ["stock", "flow", "capacity", "ratio"] } } },
          "then": { "required": ["unit"] },
          "else": { "not": { "required": ["unit"] } }
        },
        {
          "if": { "properties": { "measure": { "const": "ratio" } } },
          "then": { "properties": { "unit": { "const": "percent" } } },
          "else": { "properties": { "unit": { "not": { "const": "percent" } } } }
        },
        {
          "if": { "properties": { "measure": { "const": "stock" } } },
          "then": { "properties": { "unit": { "not": { "const": "thousand_barrels_per_day" } } } }
        }
      ]
    },
    "positioning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind", "prov", "report", "combined", "contract_market_code", "as_of_date", "category",
        "long", "short", "spreading", "open_interest", "revision"
      ],
      "properties": {
        "kind": { "const": "positioning" },
        "prov": { "$ref": "#/$defs/prov" },
        "report": { "enum": ["legacy", "disaggregated", "tff", "supplemental"] },
        "combined": { "type": "boolean" },
        "contract_market_code": { "type": "string", "pattern": "^[A-Z0-9]{1,12}$" },
        "as_of_date": { "$ref": "#/$defs/date" },
        "category": {
          "enum": [
            "total_reportable", "nonreportable", "noncommercial", "commercial", "index_traders",
            "producer_merchant", "swap_dealer", "managed_money", "other_reportable", "dealer",
            "asset_manager", "leveraged_funds"
          ]
        },
        "long": { "$ref": "#/$defs/u64" },
        "short": { "$ref": "#/$defs/u64" },
        "spreading": { "oneOf": [{ "$ref": "#/$defs/u64" }, { "type": "null" }] },
        "open_interest": { "$ref": "#/$defs/u64" },
        "revision": { "$ref": "#/$defs/u32" }
      }
    },
    "synthetic_month": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind", "prov", "derived", "exposure", "family", "month", "rank", "as_of_ms",
        "last_trade_date", "expiry_ms", "year_fraction", "fair_value", "spot", "spot_ms",
        "spot_sources", "financing_rate", "rates_ms", "carry_rate", "carry_source", "anchors",
        "anchor_ms", "implied_rate", "quality", "admissions", "grade", "label"
      ],
      "properties": {
        "kind": { "const": "synthetic_month" },
        "prov": { "$ref": "#/$defs/prov" },
        "derived": { "$ref": "#/$defs/derived" },
        "exposure": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,47}$" },
        "family": { "enum": ["equity_index", "energy", "metal", "short_rate"] },
        "month": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$" },
        "rank": { "$ref": "#/$defs/u32" },
        "as_of_ms": { "$ref": "#/$defs/ms" },
        "last_trade_date": { "$ref": "#/$defs/date" },
        "expiry_ms": { "$ref": "#/$defs/ms" },
        "year_fraction": { "$ref": "#/$defs/nonneg_decimal" },
        "fair_value": { "$ref": "#/$defs/decimal" },
        "spot": { "oneOf": [{ "$ref": "#/$defs/decimal" }, { "type": "null" }] },
        "spot_ms": { "oneOf": [{ "$ref": "#/$defs/ms" }, { "type": "null" }] },
        "spot_sources": { "$ref": "#/$defs/u32" },
        "financing_rate": { "$ref": "#/$defs/decimal" },
        "rates_ms": { "$ref": "#/$defs/ms" },
        "carry_rate": { "oneOf": [{ "$ref": "#/$defs/decimal" }, { "type": "null" }] },
        "carry_source": { "enum": ["observed", "estimated", "swap_anchor", "none"] },
        "anchors": { "$ref": "#/$defs/u32" },
        "anchor_ms": { "oneOf": [{ "$ref": "#/$defs/ms" }, { "type": "null" }] },
        "implied_rate": { "oneOf": [{ "$ref": "#/$defs/decimal" }, { "type": "null" }] },
        "quality": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "spot_stale", "spot_single_source", "spot_dispersed", "spot_tape", "rates_stale",
              "curve_extrapolated", "fixings_missing", "carry_estimated", "carry_unobserved",
              "anchor_interpolated", "anchor_extrapolated", "anchor_stale", "rolling", "expiring"
            ]
          }
        },
        "admissions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/admission_id" }
        },
        "grade": { "oneOf": [{ "enum": ["A", "B", "C", "D"] }, { "type": "null" }] },
        "label": { "enum": ["benchmark", "tape"] }
      }
    },
    "swap_text": { "type": "string", "minLength": 1, "maxLength": 128 },
    "swap_price": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": { "enum": ["price", "spread", "rate", "spread_amount"] },
        "value": { "$ref": "#/$defs/decimal" }
      }
    },
    "amount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "currency"],
      "properties": {
        "amount": { "$ref": "#/$defs/nonneg_decimal" },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
      }
    },
    "swap_print": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "prov",
        "repository",
        "dissemination_id",
        "action",
        "asset_class",
        "ts_execution_ms",
        "ts_dissemination_ms"
      ],
      "properties": {
        "kind": { "const": "swap_print" },
        "prov": { "$ref": "#/$defs/prov" },
        "repository": { "$ref": "#/$defs/venue_id" },
        "dissemination_id": { "$ref": "#/$defs/swap_text" },
        "original_dissemination_id": { "$ref": "#/$defs/swap_text" },
        "action": {
          "enum": ["new", "cancel", "correct", "modify", "terminate", "revive"]
        },
        "asset_class": {
          "enum": ["interest_rate", "credit", "equity", "foreign_exchange", "commodity"]
        },
        "upi": { "$ref": "#/$defs/swap_text" },
        "product": { "$ref": "#/$defs/swap_text" },
        "underlier": { "$ref": "#/$defs/swap_text" },
        "tenor": { "$ref": "#/$defs/swap_text" },
        "expiry": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "price": { "$ref": "#/$defs/swap_price" },
        "notional": { "$ref": "#/$defs/amount" },
        "quantity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["amount", "unit"],
          "properties": {
            "amount": { "$ref": "#/$defs/nonneg_decimal" },
            "unit": { "type": "string", "pattern": "^[A-Za-z0-9]{1,16}$" }
          }
        },
        "event_type": {
          "enum": [
            "trade",
            "novation",
            "compression",
            "early_termination",
            "clearing",
            "exercise",
            "allocation",
            "clearing_allocation",
            "credit_event",
            "porting",
            "corporate_event",
            "update"
          ]
        },
        "strike": { "$ref": "#/$defs/swap_price" },
        "option_premium": { "$ref": "#/$defs/amount" },
        "option_type": { "enum": ["call", "put"] },
        "option_style": { "enum": ["american", "european", "bermudan", "asian"] },
        "first_exercise_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "ts_execution_ms": { "$ref": "#/$defs/ms" },
        "ts_dissemination_ms": { "$ref": "#/$defs/ms" }
      }
    }
  }
}
